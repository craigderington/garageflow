# GarageFlow configuration. Copy to .env and fill in.
#
# .env is gitignored and must stay that way — it holds live credentials.
# On the server: chmod 600 .env
#
# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
PORT=8080

# Host loopback ports the production stack publishes for the host's Apache to
# proxy to. Deliberately not 3000/8080: this server runs several applications
# and the common ports collide. Kept below 32768 so they cannot clash with the
# kernel's ephemeral range. Must match infra/apache/garageflow.conf.
# Production only — ignored by the dev stack.
WEB_PORT=28300
API_PORT=28301

# Local dev talks to the containerised Postgres on host port 5434.
# In production docker-compose.prod.yml builds this from the POSTGRES_* values
# below and reaches the container directly on 5432.
DATABASE_URL=postgres://garageflow:garageflow@localhost:5434/garageflow?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Production only — consumed by docker-compose.prod.yml.
POSTGRES_USER=garageflow
POSTGRES_PASSWORD=
POSTGRES_DB=garageflow

# Sign sessions and magic-link codes. Generate with: openssl rand -hex 32
# Never ship the dev default to production.
SESSION_SECRET=

# Public base URL. Used to build magic-link and DVI report links, so it must be
# the address customers actually reach — https in production. Left at the
# default, every emailed sign-in link points at localhost and is useless to the
# recipient. In production: APP_URL=https://garageflow.studio
APP_URL=http://localhost:3000

# Caps POST /demo per client IP per minute. Provisioning a shop is expensive,
# so this is deliberately tighter than AUTH_RATE_LIMIT_PER_MIN. 0 disables it
# (used by E2E, which provisions faster than any real visitor).
DEMO_RATE_LIMIT_PER_MIN=3

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Returns the magic-link code in the POST /auth/magic-link response body so
# local dev and the Playwright suite can log in without reading email.
#
# NEVER set this in production. The code alone mints a session for any known
# email address, so enabling it is a full authentication bypass.
AUTH_DEV_CODES=true

# ---------------------------------------------------------------------------
# Object storage (MinIO). Internal-only: the API streams objects to clients
# itself, so MinIO is never exposed to browsers.
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=garageflow
MINIO_SECRET_KEY=
MINIO_BUCKET=garageflow

# ---------------------------------------------------------------------------
# Integrations. Each falls back to a no-op logging sender when unset, which is
# what local dev and E2E rely on.
# ---------------------------------------------------------------------------
# Mailgun (transactional email)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=

# Stripe. With no secret key, estimates settle immediately in dev mode and no
# real charge is made. Set STRIPE_WEBHOOK_SECRET to verify events at
# POST /webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio (SMS for inspection/estimate links)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# SMTP — legacy fallback used when Mailgun is not configured.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@garageflow.app
